---
import "../styles/global.css";
import "@fontsource/inter";

import NavBar from "../components/header/NavBar.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Unity CFDI</title>
	</head>
	<body>
		<div id="container" class="w-full h-full bg-gradient-to-b from-surface-container-low via-surface to-background">
			<header>
				<NavBar />
			</header>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	*{
		margin: 0;
		padding: 0;
	}
	html,
	body {
		height: 100%;
		margin: 0;
		width: 100%;
	}
</style>
