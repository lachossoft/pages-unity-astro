---
interface Props {
  title: string;
  Price: string;
  text: [];
}

const { title, Price, text } = Astro.props;
---

<div class="w-full flex flex-col mx-auto md:mx-4 px-4 py-8 bg-primary-1200 rounded-2xl border-primary-1200">
  <div class="w-full flex flex-col mx-auto space-y-2 border-b-1 border-secondary-600">
    <div class="flex mx-auto">
      <span class="text-primary-400 font-bold ">{title}</span>
    </div>
    <div class="flex flex-row mx-auto justify-end">
      <h2 class="flex text-white font-bold text-4xl">${Price}</h2>
      <span class="flex mx-2 my-4 text-primary-400">
        /Anual
      </span> 
    </div>
  </div>
  <div class="w-full h-[18rem] flex flex-col mx-auto mt-4 ">
    <ul class="list-disc marker:text-primary-400 pl-5">
      {
        text.map((item) =>(
          <li><span class="text-white">{item}</span></li>
        ))
      }
