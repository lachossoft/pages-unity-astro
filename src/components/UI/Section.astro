---
interface Props {
    textSection: string,
    title: string,
    text: string
}

const {text, textSection, title} = Astro.props;
---

<div class="w-42 md:w-65 h-5 md:h-7  flex flex-col items-center justify-between bg-[#eaddff] border border-[#eaddff] rounded-2xl mx-auto space-x-2"> 
    <div class="flex items-center mx-auto">   
        <span class="text-[.6rem] md:text-[1rem] text-primary font-black md:font-semibold">
            {textSection} 
        </span>
    </div>
</div>
<div class="w-full">
    <div class=" flex flex-col my-6 text-center">
        <h1 class="px-8 text-2xl md:text-5xl font-bold font-black">
            <span class="text-black">{title}</span>
        </h1>
        <div class="md:w-4xl md:mx-auto">
            <p class="my-6 mx-auto px-4 text-md md:text-xl text-neutral-600">
                {text}
            </p>
        </div>
    </div>
</div>