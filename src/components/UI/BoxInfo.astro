---
import { Icon } from 'astro-icon/components'
interface Props {
    title: string,
    titleColor:string
    text: string,
    textColor: string,
    iconName: string,
    iconColor: string
    bg:string,
    bgBox: string
}
const {title, titleColor, text, textColor, iconName, iconColor, bg, bgBox} = Astro.props;
---

<div class="w-96 h-14 flex flex-row items-center px-2 mx-4 mt-4 space-x-2 border-1 border-neutral-500 rounded-lg">
        <span class=`w-11 h-11 items-center justify-center ${bgBox} rounded-sm`>
            <Icon name={iconName} size="2rem" class=`mx-1 my-2 ${iconColor} font-bold font-black` />
        </span>
        <div class="flex flex-col">
            <span class=`text-xl ${titleColor} font-bold`>{title}</span>
            <span class=`text-sm ${textColor}`>{text}</span>
        </div>
</div>